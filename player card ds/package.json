{
  "name": "dnd-character-sheet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs --prod --open",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:build": "node scripts/build-compendium.mjs && node scripts/build-subclass-features.mjs",
    "db:subclass-features": "node scripts/build-subclass-features.mjs",
    "db:classes": "node scripts/build-class-data.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
