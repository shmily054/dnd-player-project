        "id": "spell-1",
        "name": "光亮术",
        "en": "Light",
        "level": 0,
        "school": "塑能",
        "castingTime": "1动作",
        "range": "触及",
        "components": "V、M(一只萤火虫或一片磷光苔藓)",
