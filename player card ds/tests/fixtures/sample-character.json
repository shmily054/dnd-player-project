      {
        "id": "spell-8",
        "name": "强令对决",
        "en": "Compelled Duel",
        "level": 1,
        "school": "附魔",
        "castingTime": "1附赠动作",
        "range": "30尺",
        "components": "V",
        "duration": "专注,至多1分钟",
        "concentration": true,
        "ritual": false,
        "classes": [
          "圣武士"
        ],
        "description": "你尝试强令一个生物与你决斗。指定施法距离内一个你能看\n见的生物作为法术的目标。该生物必须进行一次感知豁免,豁免\n失败则该生物将被你的神圣要求所吸引。在法术持续时间内,该\n生物对除你之外任何生物发动攻击检定时都具有劣势,并且每当\n其试图移动至与你相距超过30尺的距离时,都必须进行一次感\n知豁免。豁免成功则该目标的移动本回合内暂时不受该魔法限制。\n当你攻击另一个生物时,或者当你对另一个敌对生物施展法\n术时,又或者当一个你的友方生物对该目标造成伤害或者对其施\n展伤害性法术时,又或者你在距离该目标超过30尺的位置结束\n你的回合时,该法术终止。",
        "higherLevels": "",
        "prepared": true,
        "alwaysPrepared": false,
        "source": "圣武士",
        "note": "目标对他人攻击劣势，且难以远离你"
      },
