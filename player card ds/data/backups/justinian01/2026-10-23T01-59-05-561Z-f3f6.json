        "en": "Protection from Evil and Good",
        "level": 1,
        "school": "防护",
        "castingTime": "1动作",
        "range": "触及",
        "components": "V、S、M(圣水或者银和铁的粉末,作为该法术的耗",
        "duration": "专注,至多10分钟",
        "concentration": true,
        "ritual": false,
        "classes": [
