        "components": "V、S",
        "duration": "专注,至多1分钟",
        "concentration": true,
        "ritual": false,
        "classes": [
          "德鲁伊",
          "牧师"
        ],
        "description": "你触碰一个自愿的生物。在法术终止前,目标可以选择在一\n次属性检定时额外掷一粒d4,并将所得数值加入检定结果中。它\n可以在进行属性检定之前或之后掷骰。法术随后即终止。",
        "higherLevels": "",
        "prepared": true,
        "alwaysPrepared": false,
        "source": "圣武士",
        "note": "目标一次属性检定额外 +1d4"
      },
      {
        "id": "spell-3",
        "name": "圣火术",
        "en": "Sacred Flame",
        "level": 0,
        "school": "塑能",
        "castingTime": "1动作",
        "range": "60尺",
        "components": "V、S",
